# Biến của API. Danh sách đầy đủ được kiểm tra bởi src/config/env.schema.ts.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Kết nối bằng role ứng dụng (không superuser, không owner bảng) để RLS có hiệu lực
DATABASE_URL=postgres://rentwell_app:app_dev@127.0.0.1:5432/rentwell
REDIS_URL=redis://localhost:6379
DATABASE_POOL_MAX=10
