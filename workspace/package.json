{
  "name": "rentwell",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm run build && pnpm -r --if-present run typecheck",
    "test": "pnpm run build && pnpm -r --if-present run test",
    "format": "prettier --config ../packages/config/prettier.json --write \"../{apps,packages}/**/*.{ts,tsx,js,json}\" --ignore-path .gitignore",
    "db:up": "docker compose -f ../infra/compose/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f ../infra/compose/docker-compose.dev.yml down",
    "db:migrate": "dbmate --env DATABASE_MIGRATION_URL --migrations-dir ../db/migrations --no-dump-schema --wait up",
    "db:status": "dbmate --env DATABASE_MIGRATION_URL --migrations-dir ../db/migrations status",
    "db:seed": "docker compose -f ../infra/compose/docker-compose.dev.yml exec -T postgres psql -U postgres -d rentwell -v ON_ERROR_STOP=1 -q -f /db/seeds/001_dev_seed.sql",
    "db:test": "sh ../infra/scripts/db-test.sh",
    "storage:init": "sh ../infra/scripts/garage-init.sh",
    "format:check": "prettier --config ../packages/config/prettier.json --check \"../{apps,packages}/**/*.{ts,tsx,js,json}\" --ignore-path .gitignore"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dbmate": "^2.38.1",
    "eslint": "^10.15.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
